# Required for production builds: use the HTTPS origin of a domain your organization controls.
SITE_URL=

# Optional. Leave blank to hide the email contact option from the site.
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Analytics 4 Measurement ID (G-XXXXXXX)
# https://analytics.google.com -> Admin -> Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification code
# https://search.google.com/search-controlle -> Settings -> HTML tag
GOOGLE_SITE_VERIFICATION=
